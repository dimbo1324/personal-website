{
  "name": "dmitrii-prikhodko-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Portfolio of Dmitrii Prikhodko — Industrial Automation, IIoT & Software Engineer. Vanilla HTML/CSS/JS, no runtime dependencies.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "playlist": "node scripts/build-hero-playlist.mjs",
    "images:fetch": "node scripts/fetch-remote-images.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "cv": "python3 tools/cv/build_cv.py",
    "og": "python3 tools/og/build_og.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
