{
  "name": "@repo/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Shared domain layer: Zod schemas and typed env, usable by any app in the workspace.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "clean": "node ../../scripts/clean.mjs"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/jest": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "typescript": "catalog:"
  }
}
