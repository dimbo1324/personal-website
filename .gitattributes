# One line ending everywhere, so Windows and Linux CI see identical files.
* text=auto eol=lf

# Windows shell entry points keep CRLF for cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts and git hooks must stay LF or they fail on Linux runners.
*.sh text eol=lf
.githooks/* text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.woff2 binary
*.pdf binary
*.mp4 binary
*.webm binary

# Generated by `npm run xtask -- sync-agents`: collapse in diffs.
AGENTS.md linguist-generated=true
.codex/agents/*.toml linguist-generated=true
.codex/skills/** linguist-generated=true
package-lock.json linguist-generated=true
