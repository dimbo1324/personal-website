# Telegram Bot Token (получите у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Database URL (SQLite по умолчанию)
DATABASE_URL=sqlite+aiosqlite:///./bot_data.db

# ID администраторов бота (через запятую, Telegram user_id)
ADMIN_USER_IDS=123456789

# Строка подключения к job store планировщика (может совпадать с DATABASE_URL)
SCHEDULER_JOBSTORE_URL=sqlite:///./jobs.db

# Настройки очистки
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_DAYS=30

# Часовой пояс по умолчанию
TIMEZONE=UTC

# Уровень логирования
LOG_LEVEL=INFO
