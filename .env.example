# Copy to .env for local Astro build/dev (never commit .env).
# Public variables exposed to the client bundle MUST use the PUBLIC_ prefix.

# Canonical public site URL (no trailing slash) — sitemap, Open Graph, canonical links.
PUBLIC_SITE_URL=https://dmitriiprikhodko.com

# Cloudflare Turnstile public site key (safe to expose in client HTML).
# Use Cloudflare's always-passes testing key locally if needed: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=

# WhatsApp Click-to-Chat international phone number (digits only, no leading + or spaces).
PUBLIC_WHATSAPP_PHONE=

# WhatsApp channel mode: auto (default), real, stub or off.
# auto uses the valid PUBLIC_WHATSAPP_PHONE, otherwise the contact block shows a placeholder.
PUBLIC_WHATSAPP_MODE=auto

# Lead delivery mode for the client form: live (default) or demo.
# demo validates and acknowledges the request in the browser without any network call.
PUBLIC_LEAD_MODE=live
