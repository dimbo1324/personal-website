# Copy to .env (never commit .env) or set these as GitHub Actions variables.
# Every value is optional: with nothing set the site still works
# (form → visitor's mail app, analytics off, URLs → DEFAULT_SITE_URL in build/siteConfig.js).

# Public address of the site, no trailing slash — canonical, hreflang, Open Graph, sitemap.
VITE_SITE_URL=https://dimbo1324.github.io/portfolio

# Request form back-end. Web3Forms: get a free access key at https://web3forms.com
# (it is public by design: it can only send mail to your own inbox).
VITE_FORM_PROVIDER=web3forms
VITE_FORM_ACCESS_KEY=
# Formspree / own API instead: VITE_FORM_PROVIDER=formspree and
# VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxx
VITE_FORM_ENDPOINT=

# Privacy-friendly analytics, off by default. Visitors with Do Not Track / GPC are never counted.
# plausible → VITE_ANALYTICS_DOMAIN=your-domain   ·   umami → VITE_ANALYTICS_WEBSITE_ID=uuid
VITE_ANALYTICS_PROVIDER=none
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_WEBSITE_ID=
# Self-hosted script URL (optional): https://analytics.example.com/script.js
VITE_ANALYTICS_SRC=
