{
  // Type-checks the plain JavaScript through its JSDoc annotations — no TypeScript in the source.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["js/**/*.js", "build/**/*.js", "tests/**/*.js", "vite.config.js"],
  "exclude": ["dist", "node_modules", "js/boot/**"]
}
