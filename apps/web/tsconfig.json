{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@repo/tsconfig/next.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node", "jest"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.ts",
    "jest.setup.ts"
  ],
  "exclude": ["node_modules", ".next", "out"]
}
