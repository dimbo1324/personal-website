# Copy to `.env.local` (git-ignored) and adjust.
# Only NEXT_PUBLIC_* variables reach the browser bundle.

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Messenger deep links (public, safe in the browser bundle) --------------
# Used by the contact buttons; they work with nothing else configured.
NEXT_PUBLIC_TELEGRAM_USERNAME="prihodko_eng"
NEXT_PUBLIC_WHATSAPP_PHONE="79000000000"

# --- Lead delivery (server only) -------------------------------------------
# Leave empty to run in stub mode: /api/lead accepts the form and logs the lead
# instead of delivering it. Fill these in to switch delivery on.
#
# Telegram: create a bot with @BotFather, message it once, then read the chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# WhatsApp: Meta Cloud API. Outside the 24h session window only approved
# message templates are delivered.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_RECIPIENT=""
