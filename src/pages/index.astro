---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Telemetry from "../components/Telemetry.astro";
import Cases from "../components/Cases.astro";
import Gallery from "../components/Gallery.astro";
import Dossier from "../components/Dossier.astro";
import Contact from "../components/Contact.astro";
import Request from "../components/Request.astro";
import Footer from "../components/Footer.astro";
import ScadaWindow from "../components/ScadaWindow.astro";
import FloatingUi from "../components/FloatingUi.astro";
---

<BaseLayout>
  <a data-i18n="ui.skip-to-content" class="skip-link" href="#main">
    Skip to content
  </a>

  <div class="scroll-progress" aria-hidden="true">
    <div class="scroll-progress__bar" data-js="scroll-progress"></div>
  </div>

  <Header />

  <div class="page-flow" data-js="page-flow">
    <main id="main">
      <Hero />
      <Telemetry />
      <Cases />
      <Gallery />
      <Dossier />
      <Contact />
      <Request />
    </main>

    <Footer />
  </div>

  <ScadaWindow />
  <FloatingUi />
</BaseLayout>
