---
import Icon from "./Icon.astro";

interface Chip {
  tone: "accent" | "amber" | "plain";
  label: string;
}

interface Job {
  id: number;
  years: string;
  company: string;
  roleKey: string;
  role: string;
  metric: string;
  metricKey?: string;
  bodyKey: string;
  body: string;
  chips: Chip[];
  open?: boolean;
}

interface StackRow {
  icon: string;
  labelKey?: string;
  label: string;
  items: { label: string; core: boolean }[];
}

interface EduItem {
  years: string;
  titleKey?: string;
  title: string;
  badgeKey?: string;
  badge?: string;
  subKey: string;
  sub: string;
}

