const chipClass = (tone: Chip["tone"]): string =>
  tone === "accent" ? "chip chip--accent" : tone === "amber" ? "chip chip--amber" : "chip";
---

<section class="section" id="dossier" aria-labelledby="dossier-title">
  <div class="container">
    <header class="section-head reveal">
      <div>
        <span class="section-head__index">04</span>
        <h2 class="section-head__title" id="dossier-title">
          <span data-i18n="dossier.track-record">Track Record</span>
          <span class="section-head__accent" data-i18n="dossier.stack">
            &amp; Stack.
          </span>
        </h2>
        <p data-i18n="dossier.bridging-ot-and-it-across" class="section-head__lead">
          Bridging OT and IT across oil &amp; gas, nuclear and thermal power — from live refinery
          PLC/DCS/SIS commissioning to C++/Python digital twins.
        </p>
      </div>
    </header>

    <div class="dossier-grid">
      <ol class="timeline reveal" data-js="accordion">
        {jobs.map((job) => (
          <li class:list={["timeline__item", job.open && "is-open"]}>
            <button
              type="button"
              class="timeline__trigger"
              aria-expanded={job.open ? "true" : "false"}
              aria-controls={`job-${job.id}`}
              id={`job-${job.id}-trigger`}
            >
              <span class="timeline__years">{job.years}</span>
              <span class="timeline__heading">
                <span class="timeline__company">{job.company}</span>
                <span data-i18n={job.roleKey} class="timeline__role">
                  {job.role}
                </span>
              </span>
              <span data-i18n={job.metricKey} class="timeline__metric">
                {job.metric}
              </span>
              <Icon name="chevron-right" size="sm" class="icon timeline__chevron" />
            </button>
            <div
              class="timeline__body"
              id={`job-${job.id}`}
              role="region"
              aria-labelledby={`job-${job.id}-trigger`}
            >
              <div class="timeline__body-inner">
                <p data-i18n={job.bodyKey}>{job.body}</p>
                <ul class="chip-list">
                  {job.chips.map((chip) => (
                    <li class={chipClass(chip.tone)}>{chip.label}</li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))}
      </ol>

      <div class="skills-card reveal">
        <header class="skills-card__head">
          <span data-i18n="dossier.toolbox" class="skills-card__eyebrow">
            Toolbox
          </span>
          <h3 data-i18n="dossier.what-i-work-with" class="skills-card__title">
            What I work with
          </h3>
        </header>

        <div
          class="segmented"
          role="tablist"
          aria-label="Skill groups"
          data-js="tabs"
          data-i18n-attr="aria-label:dossier.skill-groups"
        >
          <span class="segmented__indicator" aria-hidden="true"></span>
          <button
            type="button"
            class="segmented__option is-active"
            role="tab"
            aria-selected="true"
            aria-controls="pane-ot"
            id="tab-ot"
            data-tab="ot"
          >
            <Icon name="factory" size="sm" />
            <span data-i18n="dossier.industrial">Industrial</span>
          </button>
          <button
            type="button"
            class="segmented__option"
            role="tab"
            aria-selected="false"
            aria-controls="pane-it"
            id="tab-it"
            data-tab="it"
            tabindex="-1"
          >
            <Icon name="code-xml" size="sm" />
            <span data-i18n="dossier.software">Software</span>
          </button>
          <button
            type="button"
            class="segmented__option"
            role="tab"
            aria-selected="false"
            aria-controls="pane-edu"
            id="tab-edu"
            data-tab="edu"
            tabindex="-1"
          >
            <Icon name="graduation-cap" size="sm" />
            <span data-i18n="dossier.education">Education</span>
          </button>
        </div>

        <div
          class="skills-card__pane is-active"
          role="tabpanel"
          id="pane-ot"
          aria-labelledby="tab-ot"
          data-pane="ot"
        >
          <ul class="stack-list">
            {otRows.map((row) => (
              <li class="stack-row">
                <span class="stack-row__icon">
                  <Icon name={row.icon} class="icon" />
                </span>
                <div class="stack-row__body">
                  <h4 data-i18n={row.labelKey} class="stack-row__label">
                    {row.label}
                  </h4>
                  <ul class="stack-row__items">
                    {row.items.map((item) => (
                      <li class:list={["stack-row__item", item.core && "stack-row__item--core"]}>
                        {item.label}
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div
          class="skills-card__pane"
          role="tabpanel"
          id="pane-it"
          aria-labelledby="tab-it"
          data-pane="it"
          hidden
        >
          <ul class="stack-list">
            {itRows.map((row) => (
              <li class="stack-row">
                <span class="stack-row__icon">
                  <Icon name={row.icon} class="icon" />
                </span>
                <div class="stack-row__body">
                  <h4 data-i18n={row.labelKey} class="stack-row__label">
                    {row.label}
                  </h4>
                  <ul class="stack-row__items">
                    {row.items.map((item) => (
                      <li class:list={["stack-row__item", item.core && "stack-row__item--core"]}>
                        {item.label}
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div
          class="skills-card__pane"
          role="tabpanel"
          id="pane-edu"
          aria-labelledby="tab-edu"
          data-pane="edu"
          hidden
        >
          <ol class="edu-timeline">
            {education.map((item) => (
              <li class="edu-timeline__item">
                <span class="edu-timeline__years">{item.years}</span>
                {item.badge ? (
                  <span class="edu-timeline__title">
                    <span data-i18n={item.titleKey}>{item.title}</span>{" "}
                    <span data-i18n={item.badgeKey} class="edu-timeline__badge">
                      {item.badge}
                    </span>
                  </span>
                ) : (
                  <span data-i18n={item.titleKey} class="edu-timeline__title">
                    {item.title}
                  </span>
                )}
                <span data-i18n={item.subKey} class="edu-timeline__sub">
                  {item.sub}
                </span>
              </li>
            ))}
          </ol>

          <h4 data-i18n="dossier.languages" class="stack-row__label lang-meter__heading">
            Languages
          </h4>
          <ul class="lang-meter">
            {languages.map((language) => (
              <li class="lang-meter__row">
                <span class="lang-meter__code">{language.code}</span>
                <span data-i18n={language.nameKey} class="lang-meter__name">
                  {language.name}
                </span>
                <span
                  class="lang-meter__bar"
                  role="img"
                  aria-label={language.levelText}
                  data-i18n-attr={
                    language.code === "RU"
                      ? "aria-label:dossier.native"
                      : language.code === "ES"
                        ? "aria-label:dossier.learning"
                        : undefined
                  }
                >
                  {Array.from({ length: language.level }, (_, index) => (
                    <span class:list={["lang-meter__seg", index < language.on && "is-on"]} />
                  ))}
                </span>
                <span data-i18n={language.levelKey} class="lang-meter__level">
                  {language.levelText}
                </span>
              </li>
            ))}
          </ul>
        </div>

        <p class="skills-card__legend">
          <span>
            <span
              class="skills-card__legend-dot skills-card__legend-dot--core"
              aria-hidden="true"
            ></span>
            <span data-i18n="dossier.daily-core">daily core</span>
          </span>
          <span>
            <span class="skills-card__legend-dot" aria-hidden="true"></span>
            <span data-i18n="dossier.also-used">also used</span>
          </span>
        </p>
      </div>
    </div>
  </div>
</section>
