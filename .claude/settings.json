{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(npm run gate:*)",
      "Bash(npm run fmt:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run sync-agents:*)",
      "Bash(npm run doctor:*)",
      "Bash(npm run xtask:*)",
      "Bash(npm run dev:*)",
      "Bash(npm ls:*)",
      "Bash(npm view:*)",
      "Bash(npx vitest:*)",
      "Bash(npx astro check:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git commit --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(rm -rf docs*)",
      "Bash(rm -rf .ai*)",
      "Bash(npm publish*)",
      "Bash(npx wrangler pages deploy*)",
      "Bash(npx wrangler secret*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.dev.vars)",
      "Read(./secrets/**)"
    ]
  }
}
