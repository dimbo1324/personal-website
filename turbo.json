{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "**/.env.*local",
    "tsconfig.json",
    "packages/tsconfig/*.json",
    "prettier.config.mjs"
  ],
  "globalEnv": ["NODE_ENV", "CI", "ANALYZE"],
  "tasks": {
    "topo": { "dependsOn": ["^topo"] },
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.test.*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "dev": { "dependsOn": ["^topo"], "cache": false, "persistent": true },
    "start": { "dependsOn": ["build"], "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^topo"], "outputs": [] },
    "typecheck": { "dependsOn": ["^topo"], "outputs": ["*.tsbuildinfo"] },
    "test": { "dependsOn": ["^topo"], "outputs": [] },
    "test:cov": { "dependsOn": ["^topo"], "outputs": ["coverage/**"] },
    "test:watch": { "cache": false, "persistent": true },
    "clean": { "cache": false }
  }
}
